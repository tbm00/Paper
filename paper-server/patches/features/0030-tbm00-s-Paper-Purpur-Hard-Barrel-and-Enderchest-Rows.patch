@@ -25,11 +25,18 @@ public class PlayerEnderChestContainer extends SimpleContainer {
     }
 
     public PlayerEnderChestContainer(Player owner) {
-        super(27);
+        super(54); // tbm00's Paper/Purpur - Hard Barrel and Enderchest Rows
         this.owner = owner;
         // CraftBukkit end
     }
 
+    // tbm00's Paper/Purpur start - Hard Barrel and Enderchest Rows
+    @Override
+    public int getContainerSize() {
+        return owner.sixRowEnderchestSlotCount < 0 ? super.getContainerSize() : owner.sixRowEnderchestSlotCount;
+    }
+    // tbm00's Paper/Purpur end - Hard Barrel and Enderchest Rows
+
     public void setActiveChest(EnderChestBlockEntity enderChestBlockEntity) {
         this.activeChest = enderChestBlockEntity;
